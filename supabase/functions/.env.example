# Server secrets for the `api` Edge Function. Set them with:
#   supabase secrets set --env-file supabase/functions/.env
# Never commit the real file and never put these in EXPO_PUBLIC_* variables.

# Random string; the pg_cron job sends it to trigger the scheduler (same value as the vault secret cron_secret).
CRON_SECRET=

# Facebook + Instagram — developers.facebook.com → your app → Settings → Basic
META_APP_ID=
META_APP_SECRET=

# TikTok — developers.tiktok.com → your app
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# YouTube — console.cloud.google.com → APIs & Services → Credentials (OAuth client, type "Web application")
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# X — developer.x.com → your app → Keys and tokens → OAuth 2.0 Client ID and Secret
X_CLIENT_ID=
X_CLIENT_SECRET=

# Telegram — message @BotFather, /newbot
TELEGRAM_BOT_TOKEN=

# AI writing assistant (optional). anthropic (default) or openai.
AI_PROVIDER=anthropic
AI_API_KEY=
