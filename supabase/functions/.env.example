# Server secrets only. Never use an EXPO_PUBLIC_ prefix for these values.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected by hosted Edge Functions.
PUBLIC_API_URL=https://pdecqyjanliqocfigkvd.supabase.co/functions/v1/api
META_APP_ID=1076171658459706
META_APP_SECRET=
# Generate securely as 32 random bytes encoded as base64; retain for decrypting existing tokens.
TOKEN_ENCRYPTION_KEY=
# Exact return URLs from existing signed app builds. No wildcards, queries or fragments.
OAUTH_REDIRECT_ALLOWLIST=outpost://oauth/callback,multipostly://oauth/callback
# Add the exact live web app origin only after its authenticated flow is validated.
WEB_ORIGIN_ALLOWLIST=
CRON_SECRET=
# Temporary release gate. true stops all API routes except CORS preflight; unset/false for normal operation.
MAINTENANCE_MODE=false
# Optional. Calls use the configured vendor directly and may be billable when enabled.
AI_API_KEY=
AI_PROVIDER=anthropic
AI_MODEL=

# Existing optional platform adapters (server only).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
# New live Telegram connections need channel-owner verification; the bot token alone is insufficient.
TELEGRAM_BOT_TOKEN=
