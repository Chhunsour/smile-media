# App config (bundled into the app — public values only, never secrets).
# demo = mock data on the device; live = Supabase backend below.
EXPO_PUBLIC_APP_MODE=demo
EXPO_PUBLIC_APP_NAME=MultiPostly
# Enable only after the matching Supabase provider and device flow are verified.
EXPO_PUBLIC_GOOGLE_SIGN_IN_ENABLED=false
EXPO_PUBLIC_APPLE_SIGN_IN_ENABLED=false
# Requires an approved/verified recovery email template containing {{ .Token }}.
EXPO_PUBLIC_PASSWORD_RECOVERY_ENABLED=false
# Live AI requires separately approved processor disclosure and server AI_ENABLED.
EXPO_PUBLIC_AI_ENABLED=false
# Supabase → Project Settings → API. The anon key is public; Row Level Security protects data.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
